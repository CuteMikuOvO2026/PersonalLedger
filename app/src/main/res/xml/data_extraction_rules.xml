<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- 两节都只写 <exclude>：其余数据照常备份 / 迁移，唯独 API Key 不出设备。
         cloud-backup 与 device-transfer 必须各写一遍——只写一节时另一条路径的行为
         取决于系统版本的默认语义，靠不住。 -->
    <cloud-backup>
        <exclude domain="sharedpref" path="ai_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ai_prefs.xml" />
    </device-transfer>
</data-extraction-rules>