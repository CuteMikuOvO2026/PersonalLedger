    <style name="Widget.PersonalLedger.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.PersonalLedger.BottomNavigation.ActiveIndicator</item>
